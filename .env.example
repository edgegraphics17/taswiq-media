# TasWiq Media. – Umgebungsvariablen (nach .env.local kopieren, Vercel: Project → Environment Variables)
# Ohne TASWIQ_API_* läuft die Seite lokal im Demo-Modus (Leads nur im Log, Dashboard mit Beispieldaten).

# ─── Backend (Sprite "taswiq-media" auf Fly.io) ─────────────────────
TASWIQ_API_URL=https://taswiq-media-bzj2u.sprites.app
# Gemeinsames Secret (liegt auf dem Sprite in /home/sprite/taswiq/.token) – nur serverseitig!
TASWIQ_API_TOKEN=
# Signiert das Admin-Cookie: mind. 32 Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET=
# Wer ins Dashboard darf (kommagetrennt). Muss zusätzlich auf dem Sprite in /home/sprite/taswiq/.env stehen.
ADMIN_EMAILS=

# ─── Website ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.taswiq-media.de
NEXT_PUBLIC_CALENDLY_URL=
# Bestätigungs-Codes für Suchmaschinen (nur nötig, wenn die Domain nicht per DNS-Eintrag bestätigt wird)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ─── E-Mail (Resend) ────────────────────────────────────────────────
# Benachrichtigung an uns + Bestätigung an den Lead. Ohne Key werden keine Mails verschickt.
RESEND_API_KEY=
# Signing Secret des Webhooks auf /api/webhooks/resend (Zustellung/Bounce → Verlauf der Anfrage)
RESEND_WEBHOOK_SECRET=
# Absender – Domain muss bei Resend bestätigt sein (Standard: TasWiq Media. <info@taswiq-media.de>)
MAIL_FROM=
# Bekommt jede Anfrage, kommagetrennt (Standard: info@taswiq-media.de)
LEAD_NOTIFY_TO=
# Zusätzlich bei wichtigen Anfragen – Premium oder dringend (Standard: karim@azzaoui.de)
LEAD_NOTIFY_IMPORTANT_TO=

# ─── n8n (Lead-Automation) ──────────────────────────────────────────
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
IP_HASH_SALT=

# ─── Jev (nur auf dem Sprite, siehe backend/README.md) ──────────────
# JEV_API_KEY liegt ausschließlich in /home/sprite/taswiq/.env – niemals hier oder im Repo eintragen.
